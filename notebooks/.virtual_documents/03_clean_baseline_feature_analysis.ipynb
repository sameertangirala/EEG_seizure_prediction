baseline_file_sz1 = 'chb01_07.edf'
baseline_start_sz1 = 1061  # same random baseline as before
baseline_end_sz1   = 1181

preictal_start_sz1 = seizure_1['start'] - 120  # 2876s
preictal_end_sz1   = seizure_1['start']         # 2996s

print(f"Seizure 1: {seizure_1['file']} onset {seizure_1['start']}s")
print(f"Baseline:  {baseline_file_sz1} {baseline_start_sz1}s → {baseline_end_sz1}s")
print(f"Preictal:  {preictal_start_sz1}s → {preictal_end_sz1}s")

# Extract features per channel
results_sz1 = {}

for ch in range(n_channels):
    # load baseline from clean file
    eeg_baseline = extract_eeg_from_file(baseline_file_sz1, ch)
    # load preictal from seizure file
    eeg_preictal = extract_eeg_from_file(seizure_1['file'], ch)
    
    # extract features using sliding windows
    t_b, e_b, ll_b, hf_b = extract_features_sliding(
        eeg_baseline, sfreq, baseline_start_sz1, baseline_end_sz1,
        window_sec=30, step_sec=30
    )
    t_p, e_p, ll_p, hf_p = extract_features_sliding(
        eeg_preictal, sfreq, preictal_start_sz1, preictal_end_sz1,
        window_sec=30, step_sec=30
    )
    
    # average across windows
    entropy_baseline = np.mean(e_b)
    ll_baseline      = np.mean(ll_b)
    hf_baseline      = np.mean(hf_b)
    entropy_preictal = np.mean(e_p)
    ll_preictal      = np.mean(ll_p)
    hf_preictal      = np.mean(hf_p)
    
    # % change
    entropy_change = (entropy_preictal - entropy_baseline) / entropy_baseline * 100 if entropy_baseline != 0 else 0
    ll_change      = (ll_preictal - ll_baseline)           / ll_baseline      * 100 if ll_baseline != 0 else 0
    hf_change      = (hf_preictal - hf_baseline)           / hf_baseline      * 100 if hf_baseline != 0 else 0
    
    results_sz1[ch] = {
        'channel_name':            channel_names[ch],
        'entropy_change_%':        entropy_change,
        'line_length_change_%':    ll_change,
        'hf_change_%':             hf_change,
        'entropy_values':          e_p,
        'll_values':               ll_p,
        'hf_values':               hf_p,
        'entropy_baseline_values': e_b,
        'll_baseline_values':      ll_b,
        'hf_baseline_values':      hf_b,
    }

print("✓ Features extracted for seizure 1")

# Pull data for plotting
channels  = list(results_sz1.keys())
ch_names  = [results_sz1[ch]['channel_name'] for ch in channels]
entropy_changes = [results_sz1[ch]['entropy_change_%'] for ch in channels]
ll_changes      = [results_sz1[ch]['line_length_change_%'] for ch in channels]
hf_changes      = [results_sz1[ch]['hf_change_%'] for ch in channels]

# Calculate standard error of % change per channel
entropy_se = []
ll_se      = []
hf_se      = []

for ch in channels:
    e_b  = results_sz1[ch]['entropy_baseline_values']
    e_p  = results_sz1[ch]['entropy_values']
    ll_b = results_sz1[ch]['ll_baseline_values']
    ll_p = results_sz1[ch]['ll_values']
    hf_b = results_sz1[ch]['hf_baseline_values']
    hf_p = results_sz1[ch]['hf_values']
    
    e_changes_w   = [(p - b) / b * 100 for p, b in zip(e_p, e_b)]
    ll_changes_w  = [(p - b) / b * 100 for p, b in zip(ll_p, ll_b)]
    hf_changes_w  = [(p - b) / b * 100 for p, b in zip(hf_p, hf_b)]
    
    entropy_se.append(np.std(e_changes_w)  / np.sqrt(len(e_changes_w)))
    ll_se.append(np.std(ll_changes_w)      / np.sqrt(len(ll_changes_w)))
    hf_se.append(np.std(hf_changes_w)      / np.sqrt(len(hf_changes_w)))

# Plot
fig, axes = plt.subplots(3, 1, figsize=(16, 12), sharex=True)

features = [entropy_changes, ll_changes, hf_changes]
errors   = [entropy_se, ll_se, hf_se]
labels   = ['Entropy % Change', 'Line Length % Change', 'High-Freq Power % Change']
colors   = ['steelblue', 'coral', 'mediumseagreen']
x = np.arange(len(channels))

for ax, data, err, label, color in zip(axes, features, errors, labels, colors):
    ax.bar(x, data, color=color, alpha=0.8, yerr=err, capsize=3)
    ax.axhline(0, color='black', linewidth=1.0)
    ax.set_ylabel(label, fontsize=11)
    ax.grid(True, alpha=0.3, axis='y')

axes[0].set_title(
    'Preictal vs Baseline % Change Per Channel: Seizure 1\n'
    '(chb01_03.edf, onset 2996s, clean baseline from chb01_07.edf)',
    fontsize=13, fontweight='bold'
)
axes[2].set_xlabel('Channel', fontsize=11)
axes[2].set_xticks(x)
axes[2].set_xticklabels(ch_names, rotation=45, ha='right', fontsize=9)

plt.tight_layout()
plt.savefig('per_channel_clean_baseline_sz1_updated.png', dpi=300, bbox_inches='tight')
plt.show()


# Coherence Heatmap — preictal vs interictal for chb01, seizure 1

from scipy import signal
import numpy as np
import matplotlib.pyplot as plt

WINDOW_SEC = 120
sfreq = 256

seizure = seizures_all[0]  # seizure 1
sz_start = seizure['start']

# load all 23 channels
print("Loading channels for chb01 seizure 1...")
eeg_channels = []
for ch in range(n_channels):
    try:
        eeg_channels.append(extract_eeg_from_file(seizure['file'], ch))
    except:
        eeg_channels.append(None)

# define baseline and preictal windows
# use same baseline as notebook 03 — chb01_07.edf
baseline_file  = 'chb01_07.edf'
baseline_start = 1061
baseline_end   = 1181

preictal_start = sz_start - 120
preictal_end   = sz_start

# load baseline channels
print("Loading baseline channels from chb01_07.edf...")
eeg_baseline = []
for ch in range(n_channels):
    try:
        eeg_baseline.append(extract_eeg_from_file(baseline_file, ch))
    except:
        eeg_baseline.append(None)

def compute_coherence_matrix(eeg_chs, start_sec, end_sec, sfreq, channel_names):
    """
    Compute mean coherence between every pair of channels
    for a given time window.
    Returns 23x23 matrix.
    """
    n = len(channel_names)
    coh_matrix = np.zeros((n, n))
    
    start_idx = int(start_sec * sfreq)
    end_idx   = int(end_sec   * sfreq)
    
    for i in range(n):
        for j in range(n):
            if i == j:
                coh_matrix[i, j] = 1.0  # perfect coherence with itself
                continue
            if eeg_chs[i] is None or eeg_chs[j] is None:
                coh_matrix[i, j] = 0
                continue
            seg1 = eeg_chs[i][start_idx:end_idx]
            seg2 = eeg_chs[j][start_idx:end_idx]
            if len(seg1) > 0 and len(seg2) > 0:
                nperseg = min(1024, len(seg1))
                f, coh = signal.coherence(seg1, seg2, fs=sfreq, nperseg=nperseg)
                coh_matrix[i, j] = np.mean(coh)
    
    return coh_matrix

print("Computing coherence matrices...")

# baseline coherence matrix
coh_baseline = compute_coherence_matrix(
    eeg_baseline, baseline_start, baseline_end, sfreq, channel_names
)

# preictal coherence matrix
coh_preictal = compute_coherence_matrix(
    eeg_channels, preictal_start, preictal_end, sfreq, channel_names
)

# difference matrix — what changed
coh_diff = coh_preictal - coh_baseline

print("✓ Coherence matrices computed")

# plot all three
fig, axes = plt.subplots(1, 3, figsize=(18, 6))

im0 = axes[0].imshow(coh_baseline, cmap='hot', vmin=0, vmax=1)
axes[0].set_title('Baseline Coherence\n(chb01_07.edf)', fontweight='bold')
plt.colorbar(im0, ax=axes[0])

im1 = axes[1].imshow(coh_preictal, cmap='hot', vmin=0, vmax=1)
axes[1].set_title('Preictal Coherence\n(2 min before seizure 1)', fontweight='bold')
plt.colorbar(im1, ax=axes[1])

im2 = axes[2].imshow(coh_diff, cmap='RdBu_r', vmin=-0.3, vmax=0.3)
axes[2].set_title('Difference\n(Preictal - Baseline)', fontweight='bold')
plt.colorbar(im2, ax=axes[2])

# add channel labels to all three
for ax in axes:
    ax.set_xticks(range(n_channels))
    ax.set_yticks(range(n_channels))
    ax.set_xticklabels(channel_names, rotation=90, fontsize=7)
    ax.set_yticklabels(channel_names, fontsize=7)

plt.suptitle('Inter-Channel Coherence: Baseline vs Preictal\n(chb01, seizure 1, 2-minute windows)',
             fontsize=13, fontweight='bold')
plt.tight_layout()
plt.savefig('coherence_heatmap_sz1.png', dpi=300, bbox_inches='tight')
plt.show()

# print top 10 channel pairs with biggest coherence change
print("\nTOP 10 CHANNEL PAIRS — BIGGEST COHERENCE INCREASE (preictal vs baseline):\n")
pairs = []
for i in range(n_channels):
    for j in range(i+1, n_channels):
        pairs.append((coh_diff[i,j], channel_names[i], channel_names[j]))

pairs.sort(reverse=True)
print(f"{'Rank':<6} {'Channel 1':<15} {'Channel 2':<15} {'Change':>10}")
print("-" * 50)
for rank, (diff, ch1, ch2) in enumerate(pairs[:10]):
    print(f"{rank+1:<6} {ch1:<15} {ch2:<15} {diff:>+10.4f}")

print("\nTOP 10 CHANNEL PAIRS — BIGGEST COHERENCE DECREASE:\n")
pairs.sort()
print(f"{'Rank':<6} {'Channel 1':<15} {'Channel 2':<15} {'Change':>10}")
print("-" * 50)
for rank, (diff, ch1, ch2) in enumerate(pairs[:10]):
    print(f"{rank+1:<6} {ch1:<15} {ch2:<15} {diff:>+10.4f}")

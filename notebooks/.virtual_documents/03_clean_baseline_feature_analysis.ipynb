    {'file': 'chb01_18.edf', 'start': 1720, 'end': 1810},
    {'file': 'chb01_21.edf', 'start': 327,  'end': 420},
    {'file': 'chb01_26.edf', 'start': 1862, 'end': 1963},
]

# Clean baseline files (no seizures, at least 1 hour from any seizure)
clean_files = [
    'chb01_07.edf',
    'chb01_08.edf',
    'chb01_09.edf',
    'chb01_10.edf',
    'chb01_11.edf',

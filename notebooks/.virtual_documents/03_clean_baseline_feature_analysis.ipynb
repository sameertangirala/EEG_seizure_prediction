# Cell 6: Temporal Trend Plot — 1 hour before seizure onset
# Stitches previous file + current file to get full hour before each seizure

TREND_WINDOW_SEC = 120   # 2-minute windows
TREND_STEP_SEC   = 60    # slide every 1 minute
TREND_DURATION   = 3600  # 1 hour before seizure

# map each seizure to its previous file
# previous file needed to get full hour before onset
seizure_prev_files = {
    0: 'chb01_02.edf',  # seizure 1 in chb01_03
    1: 'chb01_03.edf',  # seizure 2 in chb01_04
    2: 'chb01_14.edf',  # seizure 3 in chb01_15
    3: 'chb01_15.edf',  # seizure 4 in chb01_16
    4: 'chb01_17.edf',  # seizure 5 in chb01_18
    5: 'chb01_20.edf',  # seizure 6 in chb01_21
    6: 'chb01_25.edf',  # seizure 7 in chb01_26
}

# store results for each seizure
# all_trends[sz_idx] = {'times': [...], 'entropy': [...], 'll': [...], 'hf': [...]}
all_trends = {}

for sz_idx, seizure in enumerate(seizures_all):
    sz_start    = seizure['start']
    sz_file     = seizure['file']
    prev_file   = seizure_prev_files[sz_idx]
    
    print(f"Seizure {sz_idx+1} ({sz_file}, onset {sz_start}s)")
    print(f"  Previous file: {prev_file}")
    
    # how much data do we need from previous file?
    # if seizure onset is at 2996s we have 2996s in current file
    # we need 3600 - 2996 = 604s from previous file
    need_from_prev = TREND_DURATION - sz_start
    
    if need_from_prev <= 0:
        # seizure file has more than 1 hour before onset — no stitching needed
        prev_needed = 0
        print(f"  No stitching needed — {sz_start}s available in seizure file")
    else:
        prev_needed = need_from_prev
        print(f"  Need {prev_needed}s ({prev_needed/60:.1f} min) from previous file")
    
    # load and stitch EEG for all 23 channels
    stitched_channels = []
    
    for ch in range(n_channels):
        try:
            # load current seizure file
            eeg_current = extract_eeg_from_file(sz_file, ch)
            # take only up to seizure onset
            eeg_current = eeg_current[:int(sz_start * sfreq)]
            
            if prev_needed > 0:
                # load previous file
                eeg_prev = extract_eeg_from_file(prev_file, ch)
                # take last prev_needed seconds from previous file
                prev_samples = int(prev_needed * sfreq)
                eeg_prev = eeg_prev[-prev_samples:]
                # stitch: previous file end + current file up to seizure onset
                eeg_stitched = np.concatenate([eeg_prev, eeg_current])
            else:
                # no stitching needed — just take last 3600s of current file
                eeg_stitched = eeg_current[-int(TREND_DURATION * sfreq):]
            
            stitched_channels.append(eeg_stitched)
            
        except Exception as e:
            print(f"  Channel {ch}: failed — {e}")
            stitched_channels.append(None)
    
    print(f"  Stitched length: {len(stitched_channels[0])/sfreq:.0f}s")
    
    # slide window across the full stitched hour
    # extract features at each position
    times    = []  # time relative to seizure onset in minutes
    entropy_vals = []
    ll_vals      = []
    hf_vals      = []
    
    current_sample = 0
    total_samples  = int(TREND_DURATION * sfreq)
    window_samples = int(TREND_WINDOW_SEC * sfreq)
    step_samples   = int(TREND_STEP_SEC * sfreq)
    
    while current_sample + window_samples <= total_samples:
        
        # extract features from all channels for this window
        window_entropy = []
        window_ll      = []
        window_hf      = []
        
        for ch in range(n_channels):
            if stitched_channels[ch] is None:
                continue
            seg = stitched_channels[ch][current_sample:current_sample + window_samples]
            if len(seg) > 0:
                e  = calculate_entropy(seg)
                ll = calculate_line_length(seg)
                hf = calculate_high_freq_power(seg, sfreq)
                window_entropy.append(e)
                window_ll.append(ll)
                window_hf.append(hf)
        
        # average across all 23 channels
        entropy_vals.append(np.mean(window_entropy))
        ll_vals.append(np.mean(window_ll))
        hf_vals.append(np.mean(window_hf))
        
        # time relative to seizure onset in minutes
        # current_sample = 0 means 60 minutes before seizure
        # current_sample = total_samples means seizure onset
        time_from_onset = (current_sample + window_samples/2 - total_samples) / sfreq / 60
        times.append(time_from_onset)
        
        current_sample += step_samples
    
    all_trends[sz_idx] = {
        'times':   times,
        'entropy': entropy_vals,
        'll':      ll_vals,
        'hf':      hf_vals,
    }
    
    print(f"  ✓ {len(times)} time points extracted\n")


# ─── PLOT ───────────────────────────────────────────────────────
